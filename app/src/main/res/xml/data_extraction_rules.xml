<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ cloud backup and device-to-device transfer.
  Same contract as backup_rules.xml: keep .mmd files and settings,
  skip preview PNGs under diagrams/.thumbs.
-->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="file"
            path="." />
        <exclude
            domain="file"
            path="diagrams/.thumbs" />
        <include
            domain="sharedpref"
            path="." />
    </cloud-backup>
    <device-transfer>
        <include
            domain="file"
            path="." />
        <exclude
            domain="file"
            path="diagrams/.thumbs" />
        <include
            domain="sharedpref"
            path="." />
    </device-transfer>
</data-extraction-rules>
